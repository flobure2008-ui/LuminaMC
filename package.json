{
  "name": "lumina-mc-launcher",
  "productName": "LuminaMC",
  "version": "1.0.0",
  "description": "Launcher Minecraft Multiversion Minimaliste & Glassmorphisme (Mods, Shaders, Resource Packs, Datapacks, Modpacks, Modrinth & CurseForge, Skins 3D, Microsoft Auth)",
  "author": "LuminaMC Team",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:electron": "wait-on tcp:5173 && electron . --disable-gpu-shader-disk-cache --disable-gpu-program-cache --disable-http-cache --log-level=3",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "start": "electron . --disable-gpu-shader-disk-cache --disable-gpu-program-cache --disable-http-cache --log-level=3",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.luminamc.launcher",
    "productName": "LuminaMC",
    "copyright": "Copyright © 2026 LuminaMC",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuminaMC Launcher",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Game",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide-react": "^0.475.0",
    "minecraft-launcher-core": "^3.18.2",
    "skinview3d": "^3.4.2",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
